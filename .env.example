# Copia este archivo como .env y rellena lo que necesites. Nada aquí es obligatorio:
# sin IA, AutoDJ pincha solo (sorteo ponderado) pero no entiende el chat.

# ---------------------------------------------------------------- IA (agente DJ)
# Cadena de proveedores, en orden. Si uno falla (429, 503) o tarda más de LLM_TIMEOUT s, se salta al siguiente
# y el que falló se deja enfriando un rato. Formato: «proveedor» o «proveedor:modelo», separados por comas.
# Proveedores: groq · gemini · github · mistral · openrouter · cerebras · ollama · anthropic
LLM_CHAIN=groq,gemini,github
LLM_TIMEOUT=8

# Claves (gratuitas). Basta con una; cuantas más, más aguanta. Un proveedor sin clave se ignora.
#   Groq:          https://console.groq.com/keys          (sin tarjeta; 1.000 peticiones/día con gpt-oss-120b)
#   Gemini:        https://aistudio.google.com/apikey     (Flash-Lite: ~500 peticiones/día)
#   GitHub Models: https://github.com/settings/tokens     (token fine-grained con el permiso «Models: read»)
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# Modelos por defecto (cámbialos aquí o en LLM_CHAIN si alguno deja de estar disponible):
#   groq   → openai/gpt-oss-120b   (alternativa con mucha más cuota: openai/gpt-oss-20b)
#   gemini → gemini-3.5-flash-lite
#   github → openai/gpt-4.1-mini
# Ejemplo con dos modelos de Groq: LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini,github
# GROQ_MODEL=
# GEMINI_MODEL=
# GITHUB_MODEL=

# Razonamiento («modo pensar»): auto = el mínimo útil de cada modelo (respuestas en 1-3 s).
LLM_REASONING=auto
# Opciones que ve la IA en cada decisión: canciones candidatas y variantes de mezcla por canción.
AI_CANDIDATES=5
AI_VARIANTS=3

# Protección de la cuota en un despliegue público
# Tope de llamadas a la IA al día entre todos los visitantes (0 = sin tope)
LLM_DAILY_BUDGET=0
# Mensajes de chat por visitante: por minuto y por día (0 = sin límite)
CHAT_PER_MINUTE=6
CHAT_PER_DAY=60
# Proxies delante del backend: 1 = solo el nginx del frontend; 2 si el hosting añade otro delante
TRUSTED_PROXY_HOPS=1

# Configuración antigua de un solo proveedor (sigue funcionando, como último recurso de la cadena):
# LLM_PROVIDER=openai  LLM_BASE_URL=…  LLM_MODEL=…  LLM_API_KEY=…

# ------------------------------------------------------------- catálogo libre
# Al arrancar, si hay menos de CATALOG_MIN_TRACKS pistas de Audius/Jamendo, se importan en segundo plano
# (justo esa cantidad: cada pista se descarga y se analiza, y eso gasta CPU).
CATALOG_AUTO_IMPORT=true
CATALOG_MIN_TRACKS=12
AUDIUS_APP_NAME=AutoDJ
# Si Audius pide credenciales, créalas gratis en su panel de desarrolladores (API Plans)
AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=
# Jamendo es opcional: crea un client_id gratis en https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ------------------------------------------------------------------- análisis
ANALYSIS_WORKERS=2
# Las pistas del catálogo se analizan en segundo plano, con prioridad baja: las primeras ANALYSIS_BURST
# a ritmo normal y, a partir de ahí, con ANALYSIS_COOLDOWN_S segundos de pausa entre una y otra.
# Lo que pides tú (adjuntar, buscar en la web, añadir a la cola) se analiza enseguida.
ANALYSIS_BURST=4
ANALYSIS_COOLDOWN_S=20
# Hilos de CPU que usa Whisper (menos = va más lento pero la app se nota más fluida)
WHISPER_THREADS=2
# La letra (necesaria para el wordplay) se transcribe en local con Whisper. Modelos: tiny · base · small
ENABLE_LYRICS=true
WHISPER_MODEL=base
MAX_UPLOAD_MB=60
# Caché de pistas con el tempo ajustado (MB); al superarla se borran las menos usadas
STRETCH_CACHE_MB=300

# ------------------------------------------------------- mezcla y worker
# El trabajo pesado (análisis, letras, mezclas, stems) lo hace un proceso aparte, el worker. En Docker es el
# servicio `worker`; sin Docker puedes lanzarlo con `python -m autodj.worker` y poner AUTODJ_WORKER=external,
# o dejar AUTODJ_WORKER=inline (valor por defecto) para que corra dentro de la API.
# Límites del contenedor worker (CPUs y memoria):
WORKER_CPUS=3
WORKER_MEM=4g
# Hilos que usa el worker para estirar audio y separar stems
WORKER_THREADS=4
# Mezcla adaptativa: iguala tempo (rampas) y, si choca, la tonalidad. Con false vuelve a las mezclas clásicas.
MIX_ADAPTIVE=true
# Recortar las canciones: se mezcla tras el primer estribillo en vez de dejarlas enteras.
MIX_SHORTEN=true
# Stems (necesita Demucs en el worker). Se separan solo el principio y el final de cada pista (segundos).
STEMS_ENABLED=true
STEMS_WINDOW_S=80
STEMS_CACHE_MB=1500
# Segundos máximos que se espera a que el worker termine el clip de una mezcla antes de usar la mezcla clásica
RENDER_TIMEOUT_S=90

# Puerto local de la interfaz
AUTODJ_PORT=8080
